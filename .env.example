# Copia este archivo como .env.local para desarrollo. Sin las variables de
# Supabase la app corre en modo demo (datos ficticios en memoria).

# --- Marca y oferta (públicas) ---
NEXT_PUBLIC_BRAND_NAME=Lunes
NEXT_PUBLIC_PRICE_MXN=2500
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=        # 10 dígitos, sin +52
NEXT_PUBLIC_CAL_URL=                # liga de Cal.com para la valoración
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_OWNER=          # nombre del responsable (persona física por ahora)
NEXT_PUBLIC_PRIVACY_ADDRESS=        # domicilio para el aviso de privacidad

# --- Pagos: apagados hasta tener visto bueno legal ---
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_DEPOSIT_URL=            # liga de pago de Mercado Pago

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...
SUPABASE_SECRET_KEY=                    # sb_secret_... (solo servidor; nunca en el chat)

# --- Correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Lunes <hola@tudominio.mx>"
STAFF_ALERT_EMAIL=                  # recibe avisos de check-ins con alerta

# --- Tareas programadas ---
CRON_SECRET=                        # Vercel lo envía como Bearer en /api/cron/*

# Publicar la demo sin Supabase (muestra un aviso en cada página)
DEMO_MODE=false
